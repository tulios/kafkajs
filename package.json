{
  "name": "@dagher/kafkajs",
  "version": "2.2.8",
  "description": "A modern Apache Kafka client for node.js",
  "author": "Daniel Arthur Gallagher <him@danielarthurgallagher.dev>",
  "module": "index.mjs",
  "type": "commonjs",
  "types": "types/index.d.ts",
  "license": "MIT",
  "keywords": [
    "kafka",
    "sasl",
    "scram"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danieleloscozzese/kafkajs.git"
  },
  "bugs": {
    "url": "https://github.com/danieleloscozzese/kafkajs"
  },
  "homepage": "https://kafka.js.org",
  "scripts": {
    "jest": "export KAFKA_VERSION=${KAFKA_VERSION:='2.4'} && NODE_ENV=test echo \"KAFKA_VERSION: ${KAFKA_VERSION}\" && KAFKAJS_DEBUG_PROTOCOL_BUFFERS=1 jest",
    "test:local": "jest --detectOpenHandles",
    "test:local:watch": "npm run test:local --watch",
    "test": "npm run lint && JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh 'npx jest --ci --maxWorkers=4 --no-watchman --forceExit'",
    "lint": "find . -path ./node_modules -prune -o -path ./coverage -prune -o -path ./website -prune -o -name '*.js' -print0 | xargs -0 eslint",
    "format": "find . -path ./node_modules -prune -o -path ./coverage -prune -o -path ./website -prune -o -name '*.js' -print0 | xargs -0 prettier --write",
    "test:group:broker": "jest --forceExit --testPathPatterns 'src/broker/.*'",
    "test:group:admin": "jest --forceExit --testPathPatterns 'src/admin/.*'",
    "test:group:producer": "jest --forceExit --testPathPatterns 'src/producer/.*'",
    "test:group:consumer": "jest --forceExit --testPathPatterns 'src/consumer/.*.spec.js'",
    "test:group:others": "jest --forceExit --testPathPatterns 'src/(?!(broker|admin|producer|consumer)/).*'",
    "test:group:broker:ci": "JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh \"npm run test:group:broker --ci --maxWorkers=4 --no-watchman\"",
    "test:group:admin:ci": "JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh \"npm run test:group:admin --ci --maxWorkers=4 --no-watchman\"",
    "test:group:producer:ci": "JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh \"npm run test:group:producer --ci --maxWorkers=4 --no-watchman\"",
    "test:group:consumer:ci": "JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh \"npm run test:group:consumer --ci --maxWorkers=4 --no-watchman\"",
    "test:group:others:ci": "JEST_JUNIT_OUTPUT_NAME=test-report.xml ./scripts/testWithKafka.sh \"npm run test:group:others --ci --maxWorkers=4 --no-watchman\"",
    "test:types": "tsc -p types/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@typescript-eslint/typescript-estree": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "ip": "^2.0.1",
    "jest": "^30",
    "jest-extended": "^7.0.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^9.2.0",
    "mockdate": "^2.0.5",
    "prettier": "3.9.10",
    "semver": "^6.2.0",
    "typescript": "^6"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "git add"
    ]
  },
  "packageManager": "npm@12.2.1+sha512.6ca0a6151553fc107e60f1186d9c10d57508dcde6de31292a54d4cc4e8e8ef3de25b3281274657442d7115d10df930bb3794ddcb0681cdfd9d317189abf7b63d"
}
